{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "platformAutomerge": false,
  "schedule": ["before 6am every weekday"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 20,
  "prHourlyLimit": 0,

  "packageRules": [
    {
      "description": "Custom app images are bot-managed by update-image-tag.yml (ci/app-registry.yaml) and promoted by PR — Renovate must never touch them, on any path",
      "matchPackageNames": ["ghcr.io/techgardencode/**"],
      "enabled": false
    },
    {
      "description": "Auto-merge patch updates for helm charts — dev/core only; prod and shared/** need owner review",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["patch"],
      "matchFileNames": ["kubernetes/clusters/1276-dev/**", "kubernetes/clusters/1276-core/**"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Auto-merge patch updates for docker tags — dev/core only; prod and shared/** need owner review",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch"],
      "matchFileNames": ["kubernetes/clusters/1276-dev/**", "kubernetes/clusters/1276-core/**"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Auto-merge digest updates for base images — dev/core only; prod and shared/** need owner review",
      "matchUpdateTypes": ["digest", "pin"],
      "matchFileNames": ["kubernetes/clusters/1276-dev/**", "kubernetes/clusters/1276-core/**"],
      "automerge": true,
      "automergeType": "pr",
      "groupName": "base-image-digests"
    },
    {
      "description": "Manual review for minor/major helm chart bumps",
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false,
      "labels": ["manual-review"]
    },
    {
      "description": "Group external-dns instances",
      "matchPackageNames": ["external-dns"],
      "groupName": "external-dns"
    },
    {
      "description": "Group ingress-nginx instances",
      "matchPackageNames": ["ingress-nginx"],
      "groupName": "ingress-nginx"
    },
    {
      "description": "Group step-issuer instances",
      "matchPackageNames": ["step-issuer"],
      "groupName": "step-issuer"
    },
    {
      "description": "Group democratic-csi instances",
      "matchPackageNames": ["democratic-csi"],
      "groupName": "democratic-csi"
    },
    {
      "description": "Group external-secrets instances",
      "matchPackageNames": ["external-secrets"],
      "groupName": "external-secrets"
    },
    {
      "description": "Pin redis below 1.0 (major bump deferred)",
      "matchPackageNames": ["redis"],
      "matchDatasources": ["helm"],
      "allowedVersions": "<1.0.0"
    }
  ]
}
