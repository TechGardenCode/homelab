{
  "realm": "techgarden",
  "enabled": true,
  "accessTokenLifespan": 600,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 2,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 5184000,
  "rememberMe": true,
  "ssoSessionIdleTimeoutRememberMe": 2592000,
  "ssoSessionMaxLifespanRememberMe": 5184000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 5184000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "TechGarden administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "iris-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://dev.techgarden.gg/*"
      ],
      "webOrigins": [
        "https://dev.techgarden.gg"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://dev.techgarden.gg/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ]
    },
    {
      "clientId": "techgarden-gateway",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:KC_CLIENT_TECHGARDEN_GATEWAY_SECRET)",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://dev.techgarden.gg/oauth2/callback"
      ],
      "webOrigins": [
        "https://dev.techgarden.gg"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://dev.techgarden.gg/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ]
    }
  ],
  "users": [
    {
      "username": "kian",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "dev",
      "enabled": true,
      "emailVerified": true
    }
  ]
}
