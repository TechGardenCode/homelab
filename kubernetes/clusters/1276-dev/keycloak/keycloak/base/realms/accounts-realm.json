{
  "realm": "accounts",
  "enabled": true,
  "displayName": "Accounts",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "passwordPolicy": "length(14) and notUsername and passwordHistory(5)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "sslRequired": "external",
  "rememberMe": true,
  "ssoSessionIdleTimeoutRememberMe": 86400,
  "ssoSessionMaxLifespanRememberMe": 604800,
  "roles": {
    "realm": [
      {
        "name": "infra-admin",
        "description": "Cross-realm infrastructure admin"
      },
      {
        "name": "app-admin",
        "description": "Cross-realm application admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "broker-hausparty",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:KC_BROKER_HAUSPARTY_SECRET)",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://sso.dev.techgarden.gg/realms/hausparty/broker/accounts/endpoint"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": null
    },
    {
      "clientId": "broker-kian-coffee",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:KC_BROKER_KIAN_COFFEE_SECRET)",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://sso.dev.techgarden.gg/realms/kian-coffee/broker/accounts/endpoint"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": null
    },
    {
      "clientId": "broker-master",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:KC_BROKER_MASTER_SECRET)",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://sso.dev.techgarden.gg/realms/master/broker/accounts/endpoint"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": null
    },
    {
      "clientId": "overwatch-gateway",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:KC_CLIENT_OVERWATCH_GATEWAY_SECRET)",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://overwatch.dev.kian.sh/oauth2/callback"
      ],
      "webOrigins": [
        "https://overwatch.dev.kian.sh"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://overwatch.dev.kian.sh/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "basic",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "overwatch-machine",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:KC_CLIENT_OVERWATCH_MACHINE_SECRET)",
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-overwatch-machine",
      "enabled": true,
      "serviceAccountClientId": "overwatch-machine",
      "realmRoles": [
        "infra-admin"
      ]
    }
  ]
}
